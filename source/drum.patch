+#ifndef DRUM_FACTORY_AUDIO_H
+#define DRUM_FACTORY_AUDIO_H
+
+#include <cstdint>
+#include <span>
+
+namespace drum {
+constexpr unsigned FACTORY_FIRST_NOTE = 30;
+constexpr unsigned FACTORY_SOUND_COUNT = 32;
+std::span<const int16_t> factory_sound(unsigned index);
+} // namespace drum
+#endif
diff --git a/tools/embed_factory_audio.py b/tools/embed_factory_audio.py
new file mode 100644
index 0000000..d5f6948
--- /dev/null
+++ b/tools/embed_factory_audio.py
@@ -0,0 +1,28 @@
+"""Build read-only PCM from the factory kit. Only the main loop reads flash."""
+import struct
+import sys
+import wave
+from pathlib import Path
+
+output = Path(sys.argv[1])
+paths = sorted(map(Path, sys.argv[2:]))
+if [int(path.name.split("_")[0]) for path in paths] != list(range(30, 62)):
+    raise ValueError("Expected exactly the 32 factory WAVs for notes 30 through 61")
+with output.open("w") as cpp:
+    cpp.write('#include "factory_audio.h"\nnamespace drum {\n')
+    for i, path in enumerate(paths):
+        with wave.open(str(path), "rb") as wav:
+            if (wav.getnchannels(), wav.getsampwidth(), wav.getframerate()) != (1, 2, 44100):
+                raise ValueError(f"{path}: expected mono 16-bit 44100 Hz")
+            frames = wav.readframes(wav.getnframes())
+        pcm = struct.unpack(f"<{len(frames) // 2}h", frames)
+        cpp.write(f'const int16_t sound_{i}[] __attribute__((section(".flashdata.factory"))) = {{\n')
+        for j in range(0, len(pcm), 32):
+            cpp.write(",".join(map(str, pcm[j:j + 32])) + ",\n")
+        cpp.write("};\n")
+    cpp.write("static const std::span<const int16_t> sounds[] = {")
+    cpp.write(", ".join(f"sound_{i}" for i in range(len(paths))))
+    cpp.write("};\nstatic_assert(sizeof(sounds) / sizeof(sounds[0]) == FACTORY_SOUND_COUNT);\n")
+    cpp.write("std::span<const int16_t> factory_sound(unsigned index) {\n"
+              "  if (index >= FACTORY_SOUND_COUNT) return {};\n"
+              "  return sounds[index];\n}\n} // namespace drum\n")
