+
+void midi_print_diagnostics() {
+  int delay_ms = (int)(space1.delayTimeMs() + 0.5f);
+  uint8_t sysex[] = {
+    0xf0,
+    SYSEX_DATO_ID,
+    SYSEX_DUO_ID,
+    SYSEX_DIAGNOSTICS,
