-        audio_peak_values &= ~1UL;
-      }
-    } else {
-      audio_peak_values &= ~1UL;
-    }
+  static uint32_t last_audio_ms = 0;
+  bool loud = false;
 
-    if((audio_peak_values == 0UL)) {
-      amp_disable();
-    } else {
-      amp_enable();
+  if(peak_update_time <= peak_interval) {
+    return;
+  }
+  if(peak2.available()) {
+    loud = peak2.read() > 0.001f;
+    if(loud) {
+      last_audio_ms = millis();
     }
   }
+
+  switch(amp_state) {
+    case AMP_ASLEEP:
+      if(loud) {
+        if(digitalRead(JACK_DETECT)) {
+          // Headphones or line out: no speaker amp to wait for
+          pop_suppressor.fadeIn(2.0);
+          amp_state = AMP_AWAKE;
+        } else {
+          amp_pin(true);
+          amp_timer = 0;
+          amp_state = AMP_WAKING;
+        }
+      }
+      break;
+    case AMP_WAKING:
+      if(amp_timer >= AMP_WAKE_MUTE_MS) {
+        pop_suppressor.fadeIn(AMP_FADE_IN_MS);
+        amp_state = AMP_AWAKE;
+      }
+      break;
+    case AMP_AWAKE:
+      amp_pin(true); // follows the headphone jack
+      if((millis() - last_audio_ms) > AMP_HOLD_MS) {
+        pop_suppressor.fadeOut(AMP_FADE_OUT_MS);
+        amp_timer = 0;
+        amp_state = AMP_FADING_OUT;
+      }
+      break;
+    case AMP_FADING_OUT:
+      if(loud) {
+        pop_suppressor.fadeIn(5.0);
+        amp_state = AMP_AWAKE;
+      } else if(amp_timer >= (uint32_t)AMP_FADE_OUT_MS + 5) {
+        amp_pin(false);
+        amp_state = AMP_ASLEEP;
+      }
+      break;
+  }
