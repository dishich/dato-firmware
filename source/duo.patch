+ * Answers the diagnostics sysex f0 7d 64 0c f7 with
+ * f0 7d 64 0c <audio cpu max %> <effect cpu max %> <audio blocks max> <delay ms high 7 bits> <low 7 bits> <synth mode> <sidechain enabled> <clock source> f7
+ * and restarts the maximum counters
+ */
+void set_synth_mode(uint8_t mode) {
+  if(mode >= SYNTH_MODE_COUNT || mode == synth_mode) {
+    return;
+  }
+  synth_mode = mode;
+  eeprom_write_byte((uint8_t*)EEPROM_SYNTH_MODE, synth_mode);
+  apply_synth_mode();
+  const uint32_t mode_colours[SYNTH_MODE_COUNT] = { 0x2050FF, 0xFF8010, 0xFF2090, 0xFFFFFF };
+  flash_keys(mode_colours[mode]);
