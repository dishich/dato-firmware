+/*
+ * Keeps the delay time at a dotted eighth note of the current tempo, whatever
+ * the clock source. The time is folded into 255-510 ms: three steps when the
+ * steps run as 16th notes at 88-176 bpm, one and a half when they run as 8ths. A new time
+ * is only taken once the tempo has been steady for a moment, and the effect
+ * crossfades to it.
+ */
+void space_update() {
+  static float current_ms = 0;
+  static float pending_ms = 0;
+  static uint32_t pending_since = 0;
+
+  uint32_t pulse_us = tempo_handler.pulse_interval_us();
+  if(pulse_us < 2000 || pulse_us > 110000) {
+    return;
+  }
+  float d = pulse_us * 0.018f; // 18 pulses of the 24 ppqn clock, in ms
+  while(d > 510.0f) { d *= 0.5f; }
+  while(d <= 255.0f) { d *= 2.0f; }
+  // Stay in the current octave near the fold points instead of jumping back and forth
+  if(current_ms > 0) {
+    if(d * 2.0f <= 528.0f && fabsf(d * 2.0f - current_ms) < fabsf(d - current_ms)) {
+      d *= 2.0f;
+    } else if(d * 0.5f >= 246.0f && fabsf(d * 0.5f - current_ms) < fabsf(d - current_ms)) {
+      d *= 0.5f;
+    }
+  }
+
+  if(fabsf(d - current_ms) < current_ms * 0.015f) {
+    pending_ms = current_ms;
+    return;
+  }
+  if(fabsf(d - pending_ms) > pending_ms * 0.015f) {
+    pending_ms = d;
+    pending_since = millis();
+    return;
+  }
+  if(millis() - pending_since > 120) {
+    current_ms = pending_ms;
+    space1.delayTime(current_ms);
+  }
+}
+
