diff --git a/src/effect_gain_ramp.h b/src/effect_gain_ramp.h
new file mode 100644
index 0000000..1d6ae57
--- /dev/null
+++ b/src/effect_gain_ramp.h
@@ -0,0 +1,48 @@
+#ifndef effect_gain_ramp_h_
+#define effect_gain_ramp_h_
+/*
+  A gain that glides to its target across one audio block (2.9 ms) instead of
+  jumping at the block boundary. Used to duck the dry voice under the DRUM's
+  kick: the jump of up to 3 dB that the output mixer made was audible as a
+  tick (measured on the instrument's output, 19.11.2026).
+*/
+#include "AudioStream.h"
+
+class AudioEffectGainRamp : public AudioStream
+{
+public:
+  AudioEffectGainRamp(void) : AudioStream(1, inputQueueArray), current(32767), target(32767) {}
+  // 0.0 - 1.0
+  void gain(float level) {
+    if(level < 0.0f) { level = 0.0f; }
+    if(level > 1.0f) { level = 1.0f; }
+    target = (int32_t)(level * 32767.0f);
+  }
+  virtual void update(void) {
+    const int32_t goal = target;
+    audio_block_t *block = receiveWritable(0);
+    if(!block) {
+      current = goal;
+      return;
+    }
+    if(current != 32767 || goal != 32767) {
+      // Q24 gain, stepped once per sample
+      int32_t g = current << 9;
+      const int32_t step = ((goal - current) * 512) / AUDIO_BLOCK_SAMPLES;
+      int16_t *p = block->data;
+      for(uint16_t i = 0; i < AUDIO_BLOCK_SAMPLES; i++) {
+        g += step;
+        p[i] = (int16_t)(((int32_t)p[i] * (g >> 9)) >> 15);
+      }
+      current = goal;
+    }
+    transmit(block);
+    release(block);
+  }
+private:
+  audio_block_t *inputQueueArray[1];
+  int32_t current;          // Q15
+  volatile int32_t target;  // Q15
+};
+
+#endif
