 /*
-  Checks whether the audio amp needs to be on.
-  This prevents idle noise from the speaker
+  The speaker amp is only on while there is sound: idle, it hums.
+
+  Switching it clicks if audio is already playing when it comes up, which is
+  exactly what happens when a note wakes it. Stock firmware slept after about
+  50 ms of silence and woke on the next note with a 5 ms fade, so the first
+  note after every short pause clicked.
+
+  Here the amp wakes first, with the audio still muted, and the sound fades in
+  once it is up. Going to sleep, the sound fades out first and the amp switches
+  off after that. With headphones plugged in the speaker amp stays off and
+  nothing is muted.
  */
+#define AMP_ASLEEP 0
+#define AMP_WAKING 1
+#define AMP_AWAKE 2
+#define AMP_FADING_OUT 3
+
+const uint32_t AMP_HOLD_MS = 2500;      // quiet for this long: go to sleep
+const uint32_t AMP_WAKE_MUTE_MS = 30;   // amp powers up before any sound reaches it
+const float AMP_FADE_IN_MS = 12.0;
+const float AMP_FADE_OUT_MS = 20.0;
+
+uint8_t amp_state = AMP_ASLEEP;
+elapsedMillis amp_timer;
+
+static void amp_pin(bool on) {
+  if(on && !digitalRead(JACK_DETECT)) {
+    pinMode(AMP_ENABLE, OUTPUT);
+    digitalWrite(AMP_ENABLE, LOW);
+  } else {
+    pinMode(AMP_ENABLE, INPUT);
+  }
+}
+
