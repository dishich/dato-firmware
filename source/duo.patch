diff --git a/src/effect_space.cpp b/src/effect_space.cpp
new file mode 100644
index 0000000..b26183b
--- /dev/null
+++ b/src/effect_space.cpp
@@ -0,0 +1,197 @@
+#include "effect_space.h"
+#include <string.h>
+
+static const uint16_t COMB_LEN[SPACE_NUM_COMBS] = { 557, 593, 641, 677, 709, 743, 773, 809 };
+static const uint16_t ALLPASS_LEN[SPACE_NUM_ALLPASS] = { 277, 223, 173, 113 };
+
+static inline int32_t saturate16(int32_t x) {
+  if (x > 32767) return 32767;
+  if (x < -32768) return -32768;
+  return x;
+}
+
+// Q15 multiply that rounds toward zero, so feedback loops decay to exact silence
+static inline int32_t mul_q15(int32_t a, int32_t b) {
+  int32_t p = a * b;
+  return (p + ((p >> 31) & 32767)) >> 15;
+}
+
+static int32_t to_fixed(float value, float max, float scale) {
+  if (value < 0.0f) value = 0.0f;
+  if (value > max) value = max;
+  return (int32_t)(value * scale);
+}
+
+AudioEffectSpace::AudioEffectSpace(void) : AudioStream(1, inputQueueArray) {
+  memset(delay_buf, 0, sizeof(delay_buf));
+  memset(comb_buf_0, 0, sizeof(comb_buf_0));
+  memset(comb_buf_1, 0, sizeof(comb_buf_1));
+  memset(comb_buf_2, 0, sizeof(comb_buf_2));
+  memset(comb_buf_3, 0, sizeof(comb_buf_3));
+  memset(comb_buf_4, 0, sizeof(comb_buf_4));
+  memset(comb_buf_5, 0, sizeof(comb_buf_5));
+  memset(comb_buf_6, 0, sizeof(comb_buf_6));
+  memset(comb_buf_7, 0, sizeof(comb_buf_7));
+  memset(allpass_buf_0, 0, sizeof(allpass_buf_0));
+  memset(allpass_buf_1, 0, sizeof(allpass_buf_1));
+  memset(allpass_buf_2, 0, sizeof(allpass_buf_2));
+  memset(allpass_buf_3, 0, sizeof(allpass_buf_3));
+  comb_buf[0] = comb_buf_0;
+  comb_buf[1] = comb_buf_1;
+  comb_buf[2] = comb_buf_2;
+  comb_buf[3] = comb_buf_3;
+  comb_buf[4] = comb_buf_4;
+  comb_buf[5] = comb_buf_5;
+  comb_buf[6] = comb_buf_6;
+  comb_buf[7] = comb_buf_7;
+  allpass_buf[0] = allpass_buf_0;
+  allpass_buf[1] = allpass_buf_1;
+  allpass_buf[2] = allpass_buf_2;
+  allpass_buf[3] = allpass_buf_3;
+  for (int i = 0; i < SPACE_NUM_COMBS; i++) {
+    comb_pos[i] = 0;
+    comb_filter[i] = 0;
+  }
+  for (int i = 0; i < SPACE_NUM_ALLPASS; i++) {
+    allpass_pos[i] = 0;
+  }
+  delay_write = 0;
+  delay_target = delay_current = delay_next = SPACE_DELAY_SAMPLES / 2;
+  xfade = 0;
+  fb_lowpass = fb_highpass = 0;
+  rev_highpass = 0;
+  antialias = 0;
+  last_wet = 0;
+  feedback(0.5);
+  delayLevel(1.0);
+  reverbLevel(1.0);
+  delay_gain = delay_gain_target;
+  reverb_gain = reverb_gain_target;
+  reverbTime(0.89);
+  reverbDamping(0.35);
+}
+
+void AudioEffectSpace::delayTime(float milliseconds) {
+  float n = milliseconds * (SPACE_RATE / 1000.0) + 0.5;
+  if (n < 16.0f) n = 16.0f;
+  if (n > SPACE_DELAY_SAMPLES - 1) n = SPACE_DELAY_SAMPLES - 1;
+  delay_target = (uint16_t)n;
+}
+
+void AudioEffectSpace::feedback(float amount) {
+  fb_gain = to_fixed(amount, 0.9f, 32768.0f);
+}
+
+void AudioEffectSpace::delayLevel(float level) {
+  delay_gain_target = to_fixed(level, 1.99f, 16384.0f);
+}
+
+void AudioEffectSpace::reverbLevel(float level) {
+  reverb_gain_target = to_fixed(level, 1.99f, 16384.0f);
+}
+
+void AudioEffectSpace::reverbTime(float amount) {
+  rev_feedback = to_fixed(amount, 0.97f, 32768.0f);
+}
+
+void AudioEffectSpace::reverbDamping(float amount) {
+  rev_damp = to_fixed(amount, 0.9f, 32768.0f);
+}
+
+void AudioEffectSpace::update(void) {
+  audio_block_t *in = receiveReadOnly(0);
+  audio_block_t *out = allocate();
+  if (!out) {
+    if (in) release(in);
+    return;
+  }
+
+  // A quarter of the way to the target every block: about 12 ms to settle
+  delay_gain += (delay_gain_target - delay_gain + ((delay_gain_target > delay_gain) ? 3 : 0)) / 4;
+  reverb_gain += (reverb_gain_target - reverb_gain + ((reverb_gain_target > reverb_gain) ? 3 : 0)) / 4;
+
+  const int16_t *src = in ? in->data : 0;
+  int16_t *dst = out->data;
+  int32_t prev = last_wet;
+  int32_t aa = antialias;
+  uint16_t w = delay_write;
+
+  for (int i = 0; i < AUDIO_BLOCK_SAMPLES / 2; i++) {
+    // Halve the sample rate: one-pole lowpass (~5 kHz), then average pairs
+    int32_t s0 = 0, s1 = 0;
+    if (src) {
+      s0 = *src++;
+      s1 = *src++;
+    }
+    aa += (s0 - aa) >> 1;
+    int32_t x = aa;
+    aa += (s1 - aa) >> 1;
+    x = (x + aa) >> 1;
+
+    // Delay tap, crossfading to a new tap when the delay time changes
+    int32_t idx = (int32_t)w - delay_current;
+    if (idx < 0) idx += SPACE_DELAY_SAMPLES;
+    int32_t d = delay_buf[idx];
+    if (xfade) {
+      idx = (int32_t)w - delay_next;
+      if (idx < 0) idx += SPACE_DELAY_SAMPLES;
+      int32_t d2 = delay_buf[idx];
+      d = (d * xfade + d2 * ((1 << SPACE_XFADE_BITS) - xfade)) >> SPACE_XFADE_BITS;
+      if (--xfade == 0) delay_current = delay_next;
+    } else if (delay_current != delay_target) {
+      delay_next = delay_target;
+      xfade = (1 << SPACE_XFADE_BITS);
+    }
+
+    // Feedback path: lowpass ~2.4 kHz and highpass ~230 Hz,
+    // so every repeat gets darker and thinner
+    fb_lowpass += (d - fb_lowpass) >> 1;
+    fb_highpass += (fb_lowpass - fb_highpass) >> 4;
+    int32_t fb = fb_lowpass - fb_highpass;
+    delay_buf[w] = saturate16(x + mul_q15(fb, fb_gain));
+    if (++w >= SPACE_DELAY_SAMPLES) w = 0;
+
+    // Reverb input: the dry send plus the echoes, lows removed
+    int32_t r = x + (d >> 1);
+    rev_highpass += (r - rev_highpass) >> 4;
+    r = (r - rev_highpass) >> 4;
+
+    int32_t sum = 0;
+    for (int c = 0; c < SPACE_NUM_COMBS; c++) {
+      int16_t *buf = comb_buf[c];
+      uint16_t p = comb_pos[c];
+      int32_t y = buf[p];
+      int32_t f = y + mul_q15(comb_filter[c] - y, rev_damp);
+      comb_filter[c] = f;
+      buf[p] = saturate16(r + mul_q15(f, rev_feedback));
+      if (++p >= COMB_LEN[c]) p = 0;
+      comb_pos[c] = p;
+      sum += y;
+    }
+    int32_t v = saturate16(sum >> 1);
+    for (int a = 0; a < SPACE_NUM_ALLPASS; a++) {
+      int16_t *buf = allpass_buf[a];
+      uint16_t p = allpass_pos[a];
+      int32_t y = buf[p];
+      buf[p] = saturate16(v + (y >> 1));
+      if (++p >= ALLPASS_LEN[a]) p = 0;
+      allpass_pos[a] = p;
+      v = saturate16(y - v);
+    }
+
+    int32_t wet = saturate16((d * delay_gain + v * reverb_gain) >> 14);
+
+    // Back to the full sample rate with linear interpolation
+    *dst++ = (int16_t)((prev + wet) >> 1);
+    *dst++ = (int16_t)wet;
+    prev = wet;
+  }
+
+  delay_write = w;
+  antialias = aa;
+  last_wet = prev;
+
+  transmit(out);
+  release(out);
+  if (in) release(in);
+}
diff --git a/src/effect_space.h b/src/effect_space.h
new file mode 100644
index 0000000..6c26ca7
--- /dev/null
+++ b/src/effect_space.h
@@ -0,0 +1,80 @@
+#ifndef effect_space_h_
+#define effect_space_h_
+/*
+  "Space" send effect for the Dato DUO (melodic techno build):
+  a tempo-syncable delay with dark, thinned-out repeats, followed by a
+  Freeverb-style reverb. Runs at half the audio sample rate to fit the
+  K20's 64 KB of RAM and its CPU budget. Output is wet only.
+
+  Replaces the fixed 337 ms AudioEffectDelay of the stock firmware.
+*/
+#include "AudioStream.h"
+
+#define SPACE_RATE          (AUDIO_SAMPLE_RATE_EXACT / 2.0)
+#define SPACE_DELAY_SAMPLES 11700 // 530 ms at half rate
+#define SPACE_XFADE_BITS    9     // 512 half-rate samples = 23 ms tap crossfade
+#define SPACE_NUM_COMBS     8
+#define SPACE_NUM_ALLPASS   4
+
+class AudioEffectSpace : public AudioStream
+{
+public:
+  AudioEffectSpace(void);
+  // Delay time. A change is crossfaded, so it does not click or pitch-bend
+  void delayTime(float milliseconds);
+  // Delay feedback 0.0 - 0.9
+  void feedback(float amount);
+  // Wet levels 0.0 - 1.99
+  void delayLevel(float level);
+  void reverbLevel(float level);
+  // Reverb comb feedback 0.0 - 0.97 (tail length) and damping 0.0 - 0.9
+  void reverbTime(float amount);
+  void reverbDamping(float amount);
+  float delayTimeMs(void) { return delay_target * (1000.0 / SPACE_RATE); }
+  virtual void update(void);
+private:
+  audio_block_t *inputQueueArray[1];
+
+  // Delay
+  int16_t delay_buf[SPACE_DELAY_SAMPLES];
+  uint16_t delay_write;
+  volatile uint16_t delay_target; // in half-rate samples
+  uint16_t delay_current;
+  uint16_t delay_next;
+  uint16_t xfade;
+  int32_t fb_gain;      // Q15
+  int32_t fb_lowpass;
+  int32_t fb_highpass;
+
+  // Reverb
+  int16_t comb_buf_0[557];
+  int16_t comb_buf_1[593];
+  int16_t comb_buf_2[641];
+  int16_t comb_buf_3[677];
+  int16_t comb_buf_4[709];
+  int16_t comb_buf_5[743];
+  int16_t comb_buf_6[773];
+  int16_t comb_buf_7[809];
+  int16_t allpass_buf_0[277];
+  int16_t allpass_buf_1[223];
+  int16_t allpass_buf_2[173];
+  int16_t allpass_buf_3[113];
+  int16_t *comb_buf[SPACE_NUM_COMBS];
+  int16_t *allpass_buf[SPACE_NUM_ALLPASS];
+  uint16_t comb_pos[SPACE_NUM_COMBS];
+  int32_t comb_filter[SPACE_NUM_COMBS];
+  uint16_t allpass_pos[SPACE_NUM_ALLPASS];
+  int32_t rev_feedback; // Q15
+  int32_t rev_damp;     // Q15
+  int32_t rev_highpass;
+
+  int32_t delay_gain;   // Q14, glides to its target so a mode switch does not step
+  int32_t reverb_gain;  // Q14
+  volatile int32_t delay_gain_target;
+  volatile int32_t reverb_gain_target;
+
+  int32_t antialias;
+  int32_t last_wet;
+};
+
+#endif
