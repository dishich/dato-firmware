+  }
+  duck_enabled = enabled;
+  duck_active = false; // rejoin unity through the existing short gain ramp
+  eeprom_write_byte((uint8_t*)EEPROM_DUCK_ENABLED, enabled ? DUCK_ENABLED_MARKER : 0);
+  flash_keys(enabled ? 0x00CC30 : 0xFF1000);
