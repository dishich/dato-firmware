+
+// A kick on the DRUM: pull the dry voice down for a moment. A hit softer than
+// velocity 100 ducks proportionally less.
+void duck_trigger(uint8_t velocity) {
+  if(!duck_enabled) { return; }
+  const SynthModeVoice &voice = SYNTH_MODE_VOICE[synth_mode];
+  float amount = (velocity >= 100) ? 1.0f : velocity / 100.0f;
+  duck_floor = 1.0f - (1.0f - voice.duck_gain) * amount;
