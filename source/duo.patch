 /*
  * enter_dfu() writes a special string to the K20DX256's VBAT register and reboots the mcu
  * This signals the Kiibohd DFU bootloader that it should start in firmware update mode
diff --git a/src/synth_blep.cpp b/src/synth_blep.cpp
new file mode 100644
index 0000000..ae7e2b3
--- /dev/null
+++ b/src/synth_blep.cpp
@@ -0,0 +1,70 @@
+#include "synth_blep.h"
+
+// How far into the step we are, 0..32767, from the phase distance to the step
+// and the phase increment. Both are scaled down first so the division fits in
+// 32 bits (the K20 divides those in hardware).
+static inline int32_t step_position(uint32_t distance, uint32_t incr) {
+  uint32_t d = incr >> 11;
+  if (d == 0) return 32767;
+  uint32_t x = ((distance >> 11) << 15) / d;
+  return (x > 32767) ? 32767 : (int32_t)x;
+}
+
+// The polyBLEP residual at that position: (1 - x)^2, 32768 down to 0
+static inline int32_t residual(int32_t x) {
+  int32_t c = 32768 - x;
+  return (c * c) >> 15;
+}
+
+void AudioSynthBlep::update(void) {
+  if (tone_amp == 0) return;
+  audio_block_t *block = allocate();
+  if (!block) return;
+
+  int16_t *out = block->data;
+  uint32_t phase = tone_phase;
+  const uint32_t incr = tone_incr;
+  const int32_t amp = tone_amp;
+
+  if (tone_type == BLEP_SAWTOOTH) {
+    // Rises from 0, drops from top to bottom in the middle of its 2^31 period
+    for (int i = 0; i < AUDIO_BLOCK_SAMPLES; i++) {
+      int32_t v = (int16_t)(phase >> 15);
+      const uint32_t after = (phase + 0x40000000u) & 0x7fffffffu; // phase since the drop
+      const uint32_t before = 0x80000000u - after;                // phase until the next one
+      if (after < incr) {
+        v += residual(step_position(after, incr));
+      } else if (before < incr) {
+        v -= residual(step_position(before, incr));
+      }
+      *out++ = (int16_t)((v * amp) >> 15);
+      phase += incr;
+    }
+  } else {
+    // Low until the phase reaches the width, then high until it wraps at 2^32
+    const uint32_t width = tone_width;
+    for (int i = 0; i < AUDIO_BLOCK_SAMPLES; i++) {
+      int32_t v = (phase < width) ? -32767 : 32767;
+      const uint32_t after_rise = phase - width;
+      const uint32_t before_rise = width - phase;
+      const uint32_t after_fall = phase;
+      const uint32_t before_fall = 0u - phase;
+      if (after_rise < incr) {
+        v -= residual(step_position(after_rise, incr));
+      } else if (before_rise < incr) {
+        v += residual(step_position(before_rise, incr));
+      }
+      if (after_fall < incr) {
+        v += residual(step_position(after_fall, incr));
+      } else if (before_fall < incr && before_fall != 0) {
+        v -= residual(step_position(before_fall, incr));
+      }
+      *out++ = (int16_t)((v * amp) >> 15);
+      phase += incr;
+    }
+  }
+
+  tone_phase = phase;
+  transmit(block);
+  release(block);
+}
diff --git a/src/synth_blep.h b/src/synth_blep.h
new file mode 100644
index 0000000..f777934
--- /dev/null
+++ b/src/synth_blep.h
@@ -0,0 +1,61 @@
+#ifndef synth_blep_h_
+#define synth_blep_h_
+/*
+  Sawtooth and pulse oscillators with band-limited steps (polyBLEP).
+
+  The stock AudioSynthWaveform draws its sawtooth and pulse with hard steps.
+  Those alias: mirror images of the upper harmonics land between the real ones
+  and are heard as thin whistles that move against the note, most of all with
+  two detuned oscillators and an open filter. Here the two samples around every
+  step are rounded off, which takes the whistles down by 15 to 28 dB.
+
+  Pitch and pulse width behave exactly like the stock oscillators in this
+  firmware: the sawtooth runs at the frequency it is given, the pulse an octave
+  below it (its phase wraps at 2^32, the sawtooth's at 2^31), and pulseWidth()
+  of 1.0 gives a square wave.
+*/
+#include "AudioStream.h"
+
+#define BLEP_SAWTOOTH 0
+#define BLEP_PULSE    1
+
+class AudioSynthBlep : public AudioStream
+{
+public:
+  AudioSynthBlep(void) : AudioStream(0, NULL), tone_phase(0), tone_incr(0),
+    tone_width(0x3fffffff), tone_amp(0), tone_type(BLEP_SAWTOOTH) {
+  }
+  void frequency(float freq) {
+    if (freq < 0.0f) freq = 0.0f;
+    else if (freq > AUDIO_SAMPLE_RATE_EXACT / 2) freq = AUDIO_SAMPLE_RATE_EXACT / 2;
+    tone_incr = (uint32_t)(freq * (2147483648.0 / AUDIO_SAMPLE_RATE_EXACT) + 0.5);
+  }
+  void amplitude(float n) {
+    if (n < 0.0f) n = 0.0f;
+    else if (n > 1.0f) n = 1.0f;
+    if ((tone_amp == 0) && n) {
+      tone_phase = 0;
+    }
+    tone_amp = (int16_t)(n * 32767.0f);
+  }
+  void pulseWidth(float n) {
+    if (n < 0.0f) n = 0.0f;
+    else if (n > 1.0f) n = 1.0f;
+    tone_width = (uint32_t)(n * 2147483647.0);
+  }
+  void begin(float amp, float freq, uint8_t type) {
+    tone_type = type;
+    tone_phase = 0;
+    amplitude(amp);
+    frequency(freq);
+  }
+  virtual void update(void);
+private:
+  uint32_t tone_phase;
+  volatile uint32_t tone_incr;
+  uint32_t tone_width;
+  int16_t tone_amp;
+  uint8_t tone_type;
+};
+
+#endif
